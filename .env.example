# PostgreSQL on the R730 (docker compose service name: db)
DATABASE_URL="postgresql://stlab:CHANGE_ME@localhost:5432/stlab"

# PostgreSQL container password (Docker Compose deployment only) — read
# by deploy/docker-compose.yml's `db`, `app`, and `backup` services to
# set POSTGRES_PASSWORD, build app's DATABASE_URL, and authenticate
# backup's pg_dump/restore drill. Not read directly by `next dev`
# (DATABASE_URL above already has its own password baked in for that).
# MUST be URL-safe: docker-compose.yml interpolates this directly into
# app's DATABASE_URL (postgresql://stlab:${DB_PASSWORD}@db:5432/stlab)
# with no URL-encoding, so a password containing `/`, `+`, or `=` (e.g.
# from `openssl rand -base64`) breaks the connection string — confirmed
# live during a deploy dry-run (Prisma error P1013 "invalid port number
# in database URL"). Use hex instead, which is always URL-safe:
# Generate with: openssl rand -hex 24
DB_PASSWORD="CHANGE_ME"

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME"

# App URL as seen from lab PCs (the R730's LAN IP)
NEXT_PUBLIC_APP_URL="http://192.168.1.10:3000"

# Shared secret the lab agents use to authenticate heartbeats
AGENT_API_KEY="CHANGE_ME"

# Optional: where saved screen-recording JPEGs are written (defaults to
# ./var/screen-recordings if unset). In the Docker deployment this must
# match the volume mount in deploy/docker-compose.yml.
# SCREEN_RECORDINGS_DIR="/app/var/screen-recordings"

# Optional: where submitted homework attachments are written (defaults
# to ./var/assignment-attachments if unset). In the Docker deployment
# this must match the volume mount in deploy/docker-compose.yml.
# ASSIGNMENT_ATTACHMENTS_DIR="/app/var/assignment-attachments"

# Test database — same Postgres container as DATABASE_URL, separate DB
# name. Create once: docker exec -it <container> psql -U stlab -c
# "CREATE DATABASE stlab_test;" — used only by `npm test`/`npm run
# test:integration`, never by the running app. Put the real value in a
# gitignored .env.test, not here.
# TEST_DATABASE_URL="postgresql://stlab:CHANGE_ME@localhost:5432/stlab_test"

# Optional: days a saved screen recording (and its frames) are kept
# before the cron sweep deletes it permanently. Defaults to 90 if unset.
# RECORDING_RETENTION_DAYS="90"
